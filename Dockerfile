# Базовий образ із ЗАФІКСОВАНОЮ версією (не latest):
# python 3.12, slim = урізана версія без зайвого, bookworm = Debian 12
FROM python:3.12-slim-bookworm

# Щоб логи програми з'являлись одразу, а не накопичувались
ENV PYTHONUNBUFFERED=1

# Усі подальші команди виконуються в папці /app всередині контейнера
WORKDIR /app

# ШАР 1: спочатку копіюємо ТІЛЬКИ список залежностей і встановлюємо їх.
# Цей шар перебудовується лише коли змінився requirements.txt.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ШАР 2: тепер копіюємо код. Він змінюється часто, але залежності
# вже закешовані і заново не встановлюються.
COPY app.py .

# Створюємо звичайного користувача і працюємо від нього, а не від root
RUN useradd --create-home --uid 1000 appuser
USER appuser

# Підказка, що програма слухає порт 8000
EXPOSE 8000

# Команда запуску. 0.0.0.0 = приймати запити ззовні контейнера
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
